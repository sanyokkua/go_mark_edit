# Build output and generated dependencies
/build/bin/
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/node_modules/
/frontend/package.json.md5

# Run artefacts and local tool state
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
coverage.*
profile.cov
__pycache__/
*.pyc
/frontend/playwright-report/
/frontend/test-results/
/test-results/
/.local_tmp_files/
specs/*/evidence/

# Spec Kit: only the constitution is versioned; the Specify CLI reinstalls the rest
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md
/.claude/skills/speckit-*/
/.agents/skills/speckit-*/

# Agent working documents and local agent settings
/docs/superpowers/
/docs/audits/
.claude/settings.local.json

# Wails NSIS support files, regenerated by `wails build`
/build/windows/installer/wails_tools.nsh
/build/windows/installer/tmp/

# Local workspace and environment files
go.work
go.work.sum
.env

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
.serena/