// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`preserves rendered highlighting for bash: echo hello 1`] = `
"<code class="hljs language-bash"><span class="hljs-built_in">echo</span> hello
</code>"
`;

