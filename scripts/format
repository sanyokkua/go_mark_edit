#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: scripts/format [--check]
EOF
}

check=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) check=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) usage_error "unknown option: $1" ;;
  esac
  shift
done

cd "$REPO_ROOT"
require_command gofmt
require_command npx
require_command shfmt

go_files=()
while IFS= read -r path; do
  [[ -n "$path" && -f "$REPO_ROOT/$path" && ! -L "$REPO_ROOT/$path" ]] && go_files+=("$path")
done < <(git ls-files '*.go')

prettier_files=()
prettier_svg_files=()
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  [[ -f "$REPO_ROOT/$path" && ! -L "$REPO_ROOT/$path" ]] || continue
  case "$path" in
    .specify/* | .claude/skills/speckit-*/* | .agents/* | AGENTS.md | docs/delivery/spec/* | docs/delivery/architecture/* | frontend/wailsjs/* | frontend/dist/* | build/bin/* | */node_modules/* | package-lock.json | go.sum | justfile) continue ;;
  esac
  case "$path" in
    *.md | *.yml | *.yaml | *.json | *.css | *.ts | *.tsx | *.js | *.mjs | *.cjs | *.html | *.sql) prettier_files+=("$path") ;;
    *.svg) prettier_svg_files+=("$path") ;;
  esac
done < <(git ls-files --cached --others --exclude-standard)

shell_files=("scripts/build" "scripts/test" "scripts/verify" "scripts/format" "scripts/baseline")
while IFS= read -r path; do
  [[ -n "$path" && -f "$REPO_ROOT/$path" && ! -L "$REPO_ROOT/$path" ]] || continue
  case "$path" in
    .specify/* | .claude/skills/speckit-*/* | .agents/* | docs/delivery/spec/* | docs/delivery/architecture/*) continue ;;
  esac
  shell_files+=("$path")
done < <(git ls-files --cached --others --exclude-standard '*.sh')

prettier_command=(npx --no-install prettier)
run_prettier() {
  local args=()
  local argument
  for argument in "$@"; do
    case "$argument" in
      --*) args+=("$argument") ;;
      *) args+=("../$argument") ;;
    esac
  done
  (cd "$REPO_ROOT/frontend" && "${prettier_command[@]}" "${args[@]}")
}

run_prettier_svg() {
  local args=(--parser html)
  local argument
  for argument in "$@"; do
    case "$argument" in
      --*) args+=("$argument") ;;
      *) args+=("../$argument") ;;
    esac
  done
  (cd "$REPO_ROOT/frontend" && "${prettier_command[@]}" "${args[@]}")
}

if [[ "$check" == true ]]; then
  failed=0
  if [[ ${#go_files[@]} -gt 0 ]]; then
    gofmt_files="$(gofmt -l "${go_files[@]}")"
    if [[ -n "$gofmt_files" ]]; then
      printf '%s\n' "$gofmt_files"
      failed=1
    fi
  fi
  if [[ ${#prettier_files[@]} -gt 0 ]] && ! run_prettier --check "${prettier_files[@]}"; then
    failed=1
  fi
  if [[ ${#prettier_svg_files[@]} -gt 0 ]] && ! run_prettier_svg --check "${prettier_svg_files[@]}"; then
    failed=1
  fi
  if [[ ${#shell_files[@]} -gt 0 ]] && ! shfmt -i 2 -ci -d "${shell_files[@]}"; then
    failed=1
  fi
  exit "$failed"
fi

if [[ ${#go_files[@]} -gt 0 ]]; then gofmt -w "${go_files[@]}"; fi
if [[ ${#prettier_files[@]} -gt 0 ]]; then run_prettier --write "${prettier_files[@]}"; fi
if [[ ${#prettier_svg_files[@]} -gt 0 ]]; then run_prettier_svg --write "${prettier_svg_files[@]}"; fi
if [[ ${#shell_files[@]} -gt 0 ]]; then shfmt -i 2 -ci -w "${shell_files[@]}"; fi
