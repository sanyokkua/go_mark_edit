#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/common.sh"
. "$SCRIPT_DIR/lib/stages.sh"

usage() {
    cat <<'EOF'
Usage: scripts/verify [lint|format|build|unit|integration|e2e] [--skip e2e] [--version X.Y.Z[{-alpha.N|-beta.N}]]
EOF
}

selected='all'
skip_e2e=false
version=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --skip)
            [[ $# -ge 2 ]] || usage_error '--skip requires a stage'
            [[ "$2" == e2e ]] || usage_error 'only --skip e2e is supported'
            skip_e2e=true
            shift 2
            ;;
        --version)
            [[ $# -ge 2 && -z "$version" && -n "$2" ]] || usage_error '--version requires one release version'
            version="$2"
            shift 2
            ;;
        lint | format | build | unit | integration | e2e)
            [[ "$selected" == all ]] || usage_error 'only one stage may be selected'
            selected="$1"
            shift
            ;;
        *) usage_error "unknown option: $1" ;;
    esac
done

[[ "$selected" == e2e && "$skip_e2e" == true ]] && usage_error 'cannot select and skip e2e together'
if [[ -n "$version" ]]; then
    [[ "$selected" == all || "$selected" == build ]] || usage_error '--version requires all stages or build'
    . "$SCRIPT_DIR/lib/release_version.sh"
    parse_release_version "$version" || exit 2
fi

new_run_dir verify >/dev/null
printf '[gomarkedit] artifacts: %s\n' "$RUN_DIR"
failed=0
build_passed=false
run_named() {
    local name="$1"
    case "$name" in
        lint) capture_stage lint 'scripts/verify lint' run_lint_stage || return 1 ;;
        format) capture_stage format 'scripts/verify format' run_format_stage || return 1 ;;
        build)
            if [[ -n "$version" ]]; then
                capture_stage build "scripts/verify build --version $version" run_build_stage --version "$version" || return 1
            else
                capture_stage build 'scripts/verify build' run_build_stage || return 1
            fi
            build_passed=true
            ;;
        unit) capture_stage unit 'scripts/verify unit' run_unit_stage || return 1 ;;
        integration) capture_stage integration 'scripts/verify integration' run_integration_stage || return 1 ;;
        e2e)
            if [[ "$build_passed" == true ]]; then
                GOMARKEDIT_E2E_REUSE_DIST=1 capture_stage e2e 'scripts/verify e2e' run_e2e_stage || return 1
            else
                capture_stage e2e 'scripts/verify e2e' run_e2e_stage || return 1
            fi
            ;;
    esac
}

if [[ "$selected" != all ]]; then
    run_named "$selected" || failed=1
else
    run_named lint || failed=1
    if [[ "$failed" -eq 0 ]]; then run_named format || failed=1; fi
    if [[ "$failed" -eq 0 ]]; then run_named build || failed=1; fi
    if [[ "$failed" -eq 0 ]]; then run_named unit || failed=1; fi
    if [[ "$failed" -eq 0 ]]; then run_named integration || failed=1; fi
    if [[ "$skip_e2e" == true ]]; then
        write_skipped_stage e2e 'scripts/verify --skip e2e'
    elif [[ "$failed" -eq 0 ]]; then
        run_named e2e || failed=1
    fi
fi

if [[ "$selected" == all ]]; then
    expected_stages='all'
else
    expected_stages="$selected"
fi
node "$REPO_ROOT/tools/verify/results.mjs" summary --run-dir "$RUN_DIR" --expected "$expected_stages" --output "$RUN_DIR/summary.json" || true
[[ "$failed" -eq 0 ]] || exit 1
